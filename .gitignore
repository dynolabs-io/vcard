# Stray Go build binaries inside service dirs (CI builds inside Docker;
# local `go build` from a service dir leaves a binary named after the
# module's last path segment).
/api/services/*/vcard-api
/api/services/*/linkedin-oauth
/api/services/*/pass-signer
/api/services/*/photo-cdn
/api/services/*/web-profile

# Walk-evidence screenshots committed to feature branches for issue-comment image refs.
