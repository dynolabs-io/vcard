{
  "expo": {
    "name": "Dynolabs vCard",
    "slug": "dynolabs-vcard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dynolabs-vcard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.dynolabs.vcard",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a profile photo for your card.",
        "NSPhotoLibraryUsageDescription": "Pick a profile photo for your card from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.dynolabs.vcard",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a profile photo for your card from your library.",
          "cameraPermission": "Take a profile photo for your card."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F",
          "dark": {
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "apiBase": "https://api.dynolabs.io",
      "cdnBase": "https://cdn.dynolabs.io",
      "webBase": "https://dynolabs.io"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
